# -----------------------------------------------------------------------------
# NexusCRM — Environment Configuration
# Default setup runs with 100% free / local mock providers. Zero paid API keys needed.
# -----------------------------------------------------------------------------

# Application
APP_NAME=NexusCRM
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=nexuscrm_super_secret_development_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Local Docker Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/nexuscrm
# Fallback SQLite for lightweight testing: sqlite+aiosqlite:///./nexuscrm.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexuscrm
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexuscrm

# Redis & Cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Intelligence Layer (Provider Abstraction)
# Default is 'mock' (zero cost, zero API keys required).
# Options: mock, openai, gemini, anthropic
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# Storage (S3 compatible abstraction)
# Options: local, minio, s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexuscrm-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Email Provider Abstraction
# Options: mock, smtp, sendgrid, resend
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@nexuscrm.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Calendar Integration (Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth2callback

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Application
APP_NAME=NexusCRM
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_V1_PREFIX=/api/v1
SECRET_KEY=nexuscrm_super_secret_development_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nexuscrm
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nexuscrm

# Redis & Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Intelligence Layer (Zero-cost default)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Email
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@nexuscrm.local

# Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth2callback

# Integrations
# 32-byte url-safe base64-encoded Fernet key (e.g. generated via cryptography.fernet.Fernet.generate_key().decode())
INTEGRATION_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
